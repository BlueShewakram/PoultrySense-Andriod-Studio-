# Python AI Server
poultrysense_ai/venv/
poultrysense_ai/__pycache__/
poultrysense_ai/*.pyc
poultrysense_ai/*.log
poultrysense_ai/out.log
poultrysense_ai/err.log

# YOLO model weights (large binary — users download separately)
# poultrysense_ai/yolo11n.pt

# ReID encoder (9.9 MB, auto-downloaded by Ultralytics on first run)
poultrysense_ai/yolo26n-reid.onnx

# Old 160px OpenVINO IR backups (kept locally for rollback, not tracked)
poultrysense_ai/models/*_160bak/

# ONNX detector exports (auto-generated from the tracked .pt on first run)
poultrysense_ai/models/*.onnx

# Gemini API key & Twilio secrets — NEVER commit the real ones (use .env.example as template)
poultrysense_ai/gemini_config.json
poultrysense_ai/.env
.env

# Friend-shared datasets & training runs (large, machine-local only — see poultrysense_ai/datasets/README.md)
poultrysense_ai/datasets/
poultrysense_ai/training/
*.zip

# OpenVINO export cache (regenerated locally on first run — delete to roll back to torch)
*_openvino_model/

