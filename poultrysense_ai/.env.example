# ==============================================================
# PoultrySense AI & Twilio Notification Configuration
# ==============================================================

# Google Gemini API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Twilio SMS Alert Credentials
# Found on your Twilio Console Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Farmer Alert Recipient Phone Number (in E.164 format, e.g. +639171234567 or +15551234567)
FARMER_ALERT_PHONE_NUMBER=+63XXXXXXXXXX

# Minimum interval (seconds) between SMS alerts per chicken to avoid duplicate texts (default: 1200s / 20min)
TWILIO_ALERT_COOLDOWN_SEC=1200
