# ==============================================================
# PoultrySense AI & Twilio Notification Configuration
# ==============================================================

# Google Gemini API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# Twilio SMS Alert Credentials
# Found on your Twilio Console Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Farmer Alert Recipient Phone Number (in E.164 format, e.g. +639171234567 or +15551234567)
FARMER_ALERT_PHONE_NUMBER=+63XXXXXXXXXX

# Per-chicken Gemini cooldown (seconds). Each bird gets its own window, so one
# flagged chicken can no longer silence the rest of the flock (default: 900s /
# 15min). This gates Gemini escalation only — the end-of-scan summary SMS is
# sent once per completed scan and is never throttled.
GLOBAL_ALERT_COOLDOWN_SEC=900
# Short system-wide gap between any two Gemini calls (seconds). Keeps several
# birds from being queried at the same instant while their own cooldowns run.
GEMINI_MIN_QUERY_GAP_SEC=20
TWILIO_ALERT_COOLDOWN_SEC=900

# ==============================================================
# Streaming & Detection Pipeline
# ==============================================================
# Clean preview runs at the camera's own frame rate, independent of YOLO.
# Detection is capped at 2-3 inferences/second and always uses the newest frame.
DETECTION_MAX_RATE_HZ=3.0
# Chicken detector confidence. 0.52 is the branch default; 0.40-0.45 is a
# good sensitivity compromise, and 0.35 matches the older commit behaviour.
POULTRYSENSE_DETECTION_CONF=0.30

# Detector input size (px). 640 is most accurate, 480 is the speed/accuracy
# compromise used on the coop PC.
POULTRYSENSE_DETECTOR_IMGSZ=640

# Detector precision. OFF BY DEFAULT: INT8 is faster but only safe with a
# calibration set that looks like the coop. The classifier models always stay
# FP32. Leave POULTRYSENSE_INT8 unset (or 0) for the normal FP32 path.
# INT8 also needs the NNCF quantizer in the venv:
#   venv\Scripts\pip install "nncf>=2.14.0,<3.0.0"
# Without it the app logs a warning and keeps using FP32.
#   POULTRYSENSE_INT8=1            enable INT8 for the chicken detector only
#   POULTRYSENSE_CALIB_DATA=...    YOLO data.yaml used for calibration (best)
#   POULTRYSENSE_CALIB_DIR=...     folder of representative coop images
# With neither set, the bundled datasets/chicken_det/data.yaml is used.
# Changing size or precision re-exports the model on next start (~minutes);
# the previous export is parked beside it, not deleted.
# POULTRYSENSE_INT8=0
# POULTRYSENSE_CALIB_DATA=
# POULTRYSENSE_CALIB_DIR=

# Preview JPEG quality and maximum preview publish rate.
STREAM_JPEG_QUALITY=75
STREAM_MAX_FPS=30
