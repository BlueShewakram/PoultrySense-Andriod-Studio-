<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBarnZone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Barn Indicator Icon -->
            <FrameLayout
                android:id="@+id/flIconBg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_date_chip">

                <ImageView
                    android:id="@+id/ivBarnIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home_black_24dp"
                    app:tint="@color/primary"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBarnTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Barn Alpha • Zone 1" />

                <TextView
                    android:id="@+id/tvBarnDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    tools:text="Active physical IoT station (ESP32 DHT22 + AI Cam)" />
            </LinearLayout>

            <!-- Selection Checkmark / Circle -->
            <ImageView
                android:id="@+id/ivSelectedCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_check"
                app:tint="@color/primary"
                tools:ignore="ContentDescription" />

            <!-- Delete Custom Zone Button -->
            <ImageView
                android:id="@+id/btnDeleteZone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_delete"
                android:visibility="gone"
                app:tint="@color/critical"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Status Pills Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Camera Assignment Pill -->
            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_date_chip"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp"
                tools:text="📷 Cam 1" />

            <!-- Sensor Assignment Pill -->
            <TextView
                android:id="@+id/tvSensorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_date_chip"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp"
                tools:text="🌡️ ESP32 #1" />

            <!-- Capacity Pill -->
            <TextView
                android:id="@+id/tvCapacityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_date_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp"
                tools:text="Cap: 50" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Hardware Status Master Badge -->
            <TextView
                android:id="@+id/tvHardwareStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_healthy_badge"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/healthy"
                android:textSize="10sp"
                tools:text="ONLINE" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
