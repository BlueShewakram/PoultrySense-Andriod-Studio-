<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_modern">

    <!-- 1. Ambient Radial Glow behind the brandmark -->
    <View
        android:id="@+id/viewAmbientGlow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_sonar_ring"
        android:backgroundTint="#2600E676"
        app:layout_constraintBottom_toBottomOf="@+id/layoutBrandGroup"
        app:layout_constraintEnd_toEndOf="@+id/layoutBrandGroup"
        app:layout_constraintStart_toStartOf="@+id/layoutBrandGroup"
        app:layout_constraintTop_toTopOf="@+id/layoutBrandGroup" />

    <!-- 2. Centered Brand Identity Group -->
    <LinearLayout
        android:id="@+id/layoutBrandGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <!-- Logo Frame with Subtle Border -->
        <FrameLayout
            android:id="@+id/flLogoFrame"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_splash_logo_frame"
            android:padding="6dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_poultry_logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.10"
            android:text="POULTRY SENSE"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvBrandSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.18"
            android:text="INTELLIGENT FLOCK SYSTEMS"
            android:textColor="#76B588"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. Minimal Clean Footer Status -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_notification_dot"
            android:backgroundTint="#00E676" />

        <TextView
            android:id="@+id/tvFooterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.14"
            android:text="TELEMETRY CORE"
            android:textColor="#4B7053"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
