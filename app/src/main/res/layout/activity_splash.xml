<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_modern">

    <!-- 1. Ambient Radial Glow behind the mascot -->
    <View
        android:id="@+id/viewAmbientGlow"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_splash_ambient_glow"
        app:layout_constraintBottom_toBottomOf="@+id/layoutBrandGroup"
        app:layout_constraintEnd_toEndOf="@+id/layoutBrandGroup"
        app:layout_constraintStart_toStartOf="@+id/layoutBrandGroup"
        app:layout_constraintTop_toTopOf="@+id/layoutBrandGroup" />

    <!-- 2. Centered Brand Identity Group -->
    <LinearLayout
        android:id="@+id/layoutBrandGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44">

        <!-- 3D Mascot Container -->
        <FrameLayout
            android:id="@+id/flLogoFrame"
            android:layout_width="140dp"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/img_mascot_chicken_clean"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="PoultrySense"
            android:textColor="#0F172A"
            android:textSize="32sp" />

        <!-- Subtitle Badge -->
        <TextView
            android:id="@+id/tvBrandSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.16"
            android:text="SMART POULTRY INTELLIGENCE"
            android:textColor="#0284C7"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. Modern Progress & Footer -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Modern Pill Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSplash"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            app:indicatorColor="#0284C7"
            app:trackColor="#260284C7"
            app:trackCornerRadius="10dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tvFooterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.14"
            android:text="CONNECTING TO FLOCK SENSORS"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
