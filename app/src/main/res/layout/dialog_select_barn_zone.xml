<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_date_chip" />

    <!-- Header Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:text="Select Active Farm Zone"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Switch viewpoint, sensor telemetry, and capacity"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        app:dividerColor="@color/border_color" />

    <!-- RecyclerView of Barns/Zones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBarnZones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_barn_zone" />

    <!-- Button to Register New Barn / Pen -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddCustomZone"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="+ Register New Barn Zone"
        android:textColor="@color/primary"
        app:cornerRadius="14dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1.5dp" />

</LinearLayout>
