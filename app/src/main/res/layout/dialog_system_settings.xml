<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:backgroundTint="@color/surface"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="#33000000" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:text="System &amp; Profile Settings"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="Manage your farm credentials and profile picture"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Profile Picture Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_date_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDialogAvatarPreview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Profile Picture"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="JPG or PNG photo"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickGalleryPhoto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="sans-serif-bold"
            android:text="Upload"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_photo_camera"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- First Name Input -->
    <!-- First Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditFirstName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="First Name"
        app:boxBackgroundColor="#F8FAFC"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="#0284C7"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:hintTextColor="#0284C7"
        android:textColorHint="#64748B"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="#0284C7">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:inputType="textPersonName"
            android:textColor="#0F172A"
            android:textColorHighlight="#BAE6FD"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Last Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditLastName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Last Name"
        app:boxBackgroundColor="#F8FAFC"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="#0284C7"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:hintTextColor="#0284C7"
        android:textColorHint="#64748B"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="#0284C7">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:inputType="textPersonName"
            android:textColor="#0F172A"
            android:textColorHighlight="#BAE6FD"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Farm Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditFarmName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Poultry Farm Name"
        app:boxBackgroundColor="#F8FAFC"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="#0284C7"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:hintTextColor="#0284C7"
        android:textColorHint="#64748B"
        app:startIconDrawable="@drawable/ic_business"
        app:startIconTint="#0284C7">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditFarmName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:inputType="textCapWords"
            android:textColor="#0F172A"
            android:textColorHighlight="#BAE6FD"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Account Details info chip -->
    <TextView
        android:id="@+id/tvAccountCreatedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        tools:text="Member since August 29, 2026" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSettings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Cancel"
            android:textAllCaps="false"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfileSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:fontFamily="sans-serif-bold"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
