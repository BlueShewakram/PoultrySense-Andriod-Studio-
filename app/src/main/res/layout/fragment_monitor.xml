<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="120dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03"
                    android:text="AI Vision Monitor"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="ByteTrack Multi-Object Stream"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Connection Status Badge -->
            <LinearLayout
                android:id="@+id/layoutConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_status_connected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_notification_dot"
                    android:backgroundTint="@color/primary" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="AI Connected"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Source Selector Toggle Tabs -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleCameraSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:checkedButton="@id/btnSourceLaptop"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSourceLaptop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Laptop AI Stream"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_videocam"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSourcePhone"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Phone Sensor"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_camera_switch"
                app:iconSize="16dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Main Video Viewport Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0D1F12"
            app:cardCornerRadius="26dp"
            app:cardElevation="3dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 1. Laptop Stream Image -->
                <ImageView
                    android:id="@+id/ivMonitorStream"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="visible"
                    tools:ignore="ContentDescription" />

                <!-- 2. Phone CameraX View -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/viewCameraX"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Stream Offline Overlay -->
                <LinearLayout
                    android:id="@+id/layoutMonitorOffline"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D90E1F14"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_videocam"
                        app:tint="#80FFFFFF"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="AI Stream Waiting for Signal"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Set server IP in Profile → AI Server Settings"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- HUD Overlay (Top-Left Resolution/Source) -->
                <TextView
                    android:id="@+id/tvHudSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:background="#99000000"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="1080p AI Vision"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <!-- HUD Overlay (Top-Right FPS) -->
                <TextView
                    android:id="@+id/tvHudFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:background="#99000000"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="30.0 FPS"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp" />

                <!-- Switch Camera Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabSwitchCameraLens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:contentDescription="Switch Camera"
                    android:src="@drawable/ic_camera_switch"
                    android:visibility="gone"
                    app:backgroundTint="@color/primary"
                    app:fabSize="mini"
                    app:tint="@color/white" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Real-time AI Detections Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp"
            app:strokeColor="#0F000000"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="Active AI Detections"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDetectionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_healthy_badge"
                        android:fontFamily="sans-serif-bold"
                        android:text="3 Subjects"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Subject 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_date_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circular_badge_white"
                        android:gravity="center"
                        android:text="#1"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Active Bird • Track ID 1"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="ByteTrack Confidence 94%"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_healthy_badge"
                        android:fontFamily="sans-serif-bold"
                        android:text="NORMAL"
                        android:textColor="@color/primary"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
