<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8">

    <!-- Scrollable Main Monitor Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="120dp">

            <!-- 1. Top App Bar (Clean, Minimal, No redundant badges) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.03"
                        android:text="Flock Monitor"
                        android:textColor="#0F172A"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvMonitorSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Camera 1 • Main Coop"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Single Clean Connection Status Pill -->
                <LinearLayout
                    android:id="@+id/layoutConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_status_connected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_notification_dot"
                        android:backgroundTint="@color/primary" />

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Connected"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Clean Camera Channel Switcher -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleCameraChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/btnCam1"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCam1"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Coop 1"
                        android:textAllCaps="false"
                        android:textSize="11.5sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconSize="15dp"
                        app:strokeColor="#CBD5E1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCam2"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Brooder"
                        android:textAllCaps="false"
                        android:textSize="11.5sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconSize="15dp"
                        app:strokeColor="#CBD5E1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCam3"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nesting"
                        android:textAllCaps="false"
                        android:textSize="11.5sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconSize="15dp"
                        app:strokeColor="#CBD5E1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCamPhone"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Phone Cam"
                        android:textAllCaps="false"
                        android:textSize="11.5sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_photo_camera"
                        app:iconSize="15dp"
                        app:strokeColor="#CBD5E1" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>

            <!-- 3. Clean 16:9 Video Viewport -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVideoViewport"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Remote Stream Feed -->
                    <ImageView
                        android:id="@+id/ivMonitorStream"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="visible"
                        tools:ignore="ContentDescription" />

                    <!-- Phone CameraX View -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/viewCameraX"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- Stream Offline State -->
                    <LinearLayout
                        android:id="@+id/layoutMonitorOffline"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#E60F172A"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_videocam"
                            app:tint="#64748B"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tvOfflineTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Waiting for Camera Feed"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMonitorStatusSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="Verify AI Server IP in Profile Settings"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOfflineRetry"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="8dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="Retry"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="11.5sp"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_refresh"
                                app:iconSize="14dp"
                                app:iconTint="@color/white"
                                app:strokeColor="#475569" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOfflineUsePhoneCam"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="@color/primary"
                                android:fontFamily="sans-serif-bold"
                                android:text="Phone Camera"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="11.5sp"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_photo_camera"
                                app:iconSize="14dp"
                                app:iconTint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Top-Left Glass HUD Pill (Channel Name) -->
                    <LinearLayout
                        android:id="@+id/hudLivePill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_monitor_glass_hud"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/viewHudLiveDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_notification_dot"
                            android:backgroundTint="@color/accent_green" />

                        <TextView
                            android:id="@+id/tvHudSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="CAM 1 • MAIN COOP"
                            android:textColor="@color/white"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Top-Right Glass HUD Pill (FPS & Latency) -->
                    <LinearLayout
                        android:id="@+id/hudFpsPill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_monitor_glass_hud"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:id="@+id/tvHudFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="30.0 FPS"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvHudLatency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif"
                            android:text="• 18ms"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Bottom Overlay (Lens Flip + Shutter Snapshot) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom"
                        android:background="#990F172A"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/tvActiveCameraLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Camera 1 Active"
                            android:textColor="@color/white"
                            android:textSize="11.5sp" />

                        <!-- Lens Flip Action -->
                        <ImageView
                            android:id="@+id/btnFlipCameraLens"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_dock_btn_circle"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_camera_switch"
                            app:tint="@color/primary"
                            tools:ignore="ContentDescription" />

                        <!-- Frame Snapshot Shutter Action -->
                        <ImageView
                            android:id="@+id/btnCaptureSnapshot"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_dock_btn_circle"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_camera_snapshot"
                            app:tint="@color/primary"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>

                    <!-- Shutter Flash Overlay -->
                    <View
                        android:id="@+id/viewShutterFlash"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@color/white" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Telemetry KPI Grid (No fake feeding/roosting, real metrics) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Flock Telemetry"
                                android:textColor="#0F172A"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvTelemetrySub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="ByteTrack Multi-Object Intelligence • Cam 1"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetectionCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_healthy_badge"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="3 Subjects"
                            android:textColor="@color/primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Metric Triplet Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Metric 1: Tracked Birds -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_kpi_stat_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tvTelemetryCountVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="3"
                                android:textColor="@color/primary"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="Birds Tracked"
                                android:textColor="#64748B"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <!-- Metric 2: Flock Posture Index -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_kpi_stat_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tvTelemetryPostureVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="99.4%"
                                android:textColor="@color/primary"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="Health Index"
                                android:textColor="#64748B"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <!-- Metric 3: AI Latency -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_kpi_stat_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tvTelemetryLatencyVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="0.03s"
                                android:textColor="#1976D2"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="Inference"
                                android:textColor="#64748B"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Active Detected Subjects Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Tracked Flock Subjects"
                        android:textColor="#0F172A"
                        android:textSize="13sp" />

                    <!-- Subject Item 1 -->
                    <LinearLayout
                        android:id="@+id/rowTrackSubject1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_kpi_stat_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_badge_white"
                            android:gravity="center"
                            android:text="#1"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSubject1Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Track ID 1"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvSubject1Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="ByteTrack Confidence 96% • Stable"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSubject1Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_healthy_badge"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="NORMAL"
                            android:textColor="@color/primary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Subject Item 2 -->
                    <LinearLayout
                        android:id="@+id/rowTrackSubject2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_kpi_stat_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_badge_white"
                            android:gravity="center"
                            android:text="#2"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSubject2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Track ID 2"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvSubject2Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="ByteTrack Confidence 92% • Active"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSubject2Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_healthy_badge"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="NORMAL"
                            android:textColor="@color/primary"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. AI Checkup Session Controller (Clean, No Emojis) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCheckupSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top Row: Status Dot + Title + Schedule Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewSessionDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_notification_dot"
                            android:backgroundTint="@color/text_muted" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSessionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Flock Inspection Session"
                                android:textColor="#0F172A"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvSessionSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif"
                                android:text="Idle • Ready to begin automated inspection"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <!-- Schedule Action Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenScheduleDialog"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="12dp"
                            android:text="Schedule"
                            android:textColor="@color/primary"
                            android:textSize="11.5sp"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_calendar_today"
                            app:iconSize="14dp"
                            app:iconTint="@color/primary"
                            app:strokeColor="#CBD5E1" />
                    </LinearLayout>

                    <!-- Active Session Countdown View -->
                    <LinearLayout
                        android:id="@+id/layoutActiveSessionBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_date_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/tvSessionTimerLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Time remaining:"
                            android:textColor="#475569"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSessionCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="29:45"
                            android:textColor="@color/primary"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Next Scheduled Run Info -->
                    <TextView
                        android:id="@+id/tvScheduledRunInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Next Scheduled: Daily at 08:00 AM • 30 mins"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <!-- Start / Stop Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleSession"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/primary"
                        android:fontFamily="sans-serif-bold"
                        android:text="Start Inspection Session"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:cornerRadius="12dp"
                        app:elevation="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Clean Offline Side Notification (No Emojis) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCuteMascotAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="94dp"
        android:visibility="gone"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circular_badge_white"
                        android:backgroundTint="#1E293B" />

                    <ImageView
                        android:id="@+id/imgMascotChicken"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_mascot_chicken_clean"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMascotTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Camera Disconnected"
                            android:textColor="@color/white"
                            android:textSize="12.5sp" />

                        <ImageButton
                            android:id="@+id/btnDismissMascotAlert"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="3dp"
                            android:src="@drawable/ic_close"
                            app:tint="#94A3B8"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMascotMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Check stream URL or use phone sensor."
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Chips Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMascotAutoDetect"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:text="Auto-Detect"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#475569" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMascotUsePhoneCam"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="@color/primary"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:text="Phone Camera"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3D Mascot Scanner POPUP Overlay in the Center -->
    <com.example.poultrysense.ui.monitor.OrbitingMascotScannerView
        android:id="@+id/mascotPopupScanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
