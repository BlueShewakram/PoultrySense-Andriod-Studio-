<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Scrollable Main Monitor Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp">

            <!-- 1. Header: Page Title & Connection Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.03"
                        android:text="AI Vision Monitor"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvMonitorSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Camera 1 • Main Barn Flock"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Connection Status Badge -->
                <LinearLayout
                    android:id="@+id/layoutConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_status_connected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_notification_dot"
                        android:backgroundTint="@color/primary" />

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="AI Connected"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Clean 1-3 Camera Channel Switcher Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleCameraChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/btnCam1"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCam1"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Cam 1 (Main Coop)"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconSize="15dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCam2"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Cam 2 (Brooder)"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconSize="15dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCam3"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Cam 3 (Nesting)"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconSize="15dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCamPhone"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Phone Cam"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_photo_camera"
                        app:iconSize="15dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>

            <!-- 3. Main 16:9 Video Viewport Card (Clean, No Green Frame) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVideoViewport"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#0D1810"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- 1. Stream Image -->
                    <ImageView
                        android:id="@+id/ivMonitorStream"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="visible"
                        tools:ignore="ContentDescription" />

                    <!-- 2. Phone CameraX View -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/viewCameraX"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- 3. Stream Offline Placeholder -->
                    <LinearLayout
                        android:id="@+id/layoutMonitorOffline"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#E60D1810"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_videocam"
                            app:tint="#80FFFFFF"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tvOfflineTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Camera Stream Waiting for Signal"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMonitorStatusSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="Check server IP in Profile → AI Server Settings"
                            android:textColor="#A0FFFFFF"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOfflineRetry"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Retry Stream"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_refresh"
                            app:iconSize="14dp"
                            app:iconTint="@color/white"
                            app:strokeColor="#66FFFFFF" />
                    </LinearLayout>

                    <!-- 4. Top-Left HUD Pill (Active Camera Channel) -->
                    <LinearLayout
                        android:id="@+id/hudLivePill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_hud_pill_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/viewHudLiveDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_notification_dot"
                            android:backgroundTint="@color/accent_green" />

                        <TextView
                            android:id="@+id/tvHudSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="CAM 1 • MAIN COOP"
                            android:textColor="@color/white"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 5. Top-Right HUD Pill (FPS & Latency) -->
                    <LinearLayout
                        android:id="@+id/hudFpsPill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_hud_pill_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:id="@+id/tvHudFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="30.0 FPS"
                            android:textColor="@color/accent_green"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvHudLatency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="• 18ms"
                            android:textColor="#B3FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 6. Shutter Flash Overlay for Snapshots -->
                    <View
                        android:id="@+id/viewShutterFlash"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@color/white" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Floating Control Bar (Flip Lens & Snapshot) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_camera_dock_glass"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvActiveCameraLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Camera 1 Active • 1080p Stream"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Lens Flip Action (Rear / Front Camera) -->
                <ImageView
                    android:id="@+id/btnFlipCameraLens"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dock_btn_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera_switch"
                    app:tint="@color/primary"
                    tools:ignore="ContentDescription" />

                <!-- Frame Snapshot Shutter Action -->
                <ImageView
                    android:id="@+id/btnCaptureSnapshot"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_dock_btn_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera_snapshot"
                    app:tint="@color/primary"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

            <!-- 5. Real-time AI Flock Telemetry Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Live Flock Telemetry"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvTelemetrySub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="ByteTrack Multi-Object Intelligence • Cam 1"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetectionCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_healthy_badge"
                            android:fontFamily="sans-serif-bold"
                            android:text="3 Subjects"
                            android:textColor="@color/primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Metric Triplet Pills -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- Metric 1: Detected Flock -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_date_chip"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tvTelemetryCountVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="3"
                                android:textColor="@color/primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Birds Tracked"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Metric 2: Flock Posture Index -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_date_chip"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tvTelemetryPostureVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="99.4%"
                                android:textColor="@color/primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Normal Behavior"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Metric 3: AI Inference Latency -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_date_chip"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tvTelemetryLatencyVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="0.03s"
                                android:textColor="#1976D2"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="AI Latency"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Active Detected Subjects List Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Identified Bird Tracks"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- Subject Item 1 -->
                    <LinearLayout
                        android:id="@+id/rowTrackSubject1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_date_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_badge_white"
                            android:gravity="center"
                            android:text="#1"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSubject1Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Active Bird • Track ID 1"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvSubject1Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="ByteTrack Confidence 96% • Stable"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSubject1Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_healthy_badge"
                            android:fontFamily="sans-serif-bold"
                            android:text="NORMAL"
                            android:textColor="@color/primary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Subject Item 2 -->
                    <LinearLayout
                        android:id="@+id/rowTrackSubject2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_date_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circular_badge_white"
                            android:gravity="center"
                            android:text="#2"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSubject2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Active Bird • Track ID 2"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvSubject2Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="ByteTrack Confidence 92% • Active Feeding"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSubject2Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_healthy_badge"
                            android:fontFamily="sans-serif-bold"
                            android:text="FEEDING"
                            android:textColor="@color/primary"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3D Mascot Scanner POPUP Overlay in the Center -->
    <com.example.poultrysense.ui.monitor.OrbitingMascotScannerView
        android:id="@+id/mascotPopupScanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
