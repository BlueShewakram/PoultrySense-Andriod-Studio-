<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 1. Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_capsule_ai"
            android:padding="8dp"
            android:src="@drawable/ic_calendar_today"
            app:tint="@color/primary"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Schedule AI Flock Checkup"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Automate camera analysis &amp; health logging"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchScheduleActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:dividerColor="@color/border_light" />

    <!-- 2. Time Picker Card -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="Checkup Time"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPickTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_history"
                app:tint="@color/primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="--:--"
                android:textColor="#0F172A"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Change Time"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Duration Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Checkup Duration"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDur5"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 Mins"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDur10"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 Mins"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDur15"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 Mins"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDur30"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="30 Mins"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDur60"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 Hour"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDur120"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 Hours"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDurContinuous"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continuous"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 4. Frequency / Recurrence -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-bold"
        android:text="Frequency"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupRepeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRepeatDaily"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Daily"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRepeatWeekdays"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekdays"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRepeatOnce"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Once"
            android:textColor="@color/chip_state_text_color"
            app:chipBackgroundColor="@color/chip_state_background_color"
            app:chipStrokeColor="#CBD5E1" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 5. Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSchedule"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Cancel"
            android:textColor="@color/text_muted"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSchedule"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:fontFamily="sans-serif-bold"
            android:text="Save Schedule"
            android:textColor="@color/white"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
