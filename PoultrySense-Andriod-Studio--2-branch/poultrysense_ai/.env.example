# ==============================================================
# PoultrySense AI & Twilio Notification Configuration
# ==============================================================

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Twilio SMS Alert Credentials
# Found on your Twilio Console Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Farmer Alert Recipient Phone Number (in E.164 format, e.g. +639171234567 or +15551234567)
FARMER_ALERT_PHONE_NUMBER=+63XXXXXXXXXX

# Unified Global Alert & Twilio SMS Cooldown (seconds) across all chickens to handle tracker ID switches (default: 900s / 15min)
GLOBAL_ALERT_COOLDOWN_SEC=900
TWILIO_ALERT_COOLDOWN_SEC=900

# ==============================================================
# Hardware Acceleration & Detection Pipeline (AMD Optimized)
# ==============================================================
# Acceleration engine:
#   DIRECTML  -> Native DirectX 12 GPU acceleration for AMD Radeon RX 580 (fastest: ~70 FPS)
#   OPENVINO  -> Intel OpenVINO GPU/CPU acceleration (~30 FPS)
#   CPU       -> Pure CPU PyTorch / oneDNN AVX2 execution
AI_ACCELERATION_BACKEND=DIRECTML

# OpenVINO target device (when AI_ACCELERATION_BACKEND=OPENVINO): GPU, CPU, or AUTO
OPENVINO_DEVICE=GPU

# Multi-object tracker: bytetrack (recommended for poultry flocks) or botsort
TRACKER_TYPE=bytetrack

# Maximum detection rate in inferences per second (Hz).
# 12.0 provides smooth, responsive 12 AI/s detection without overheating the GPU.
DETECTION_MAX_RATE_HZ=12.0

# Chicken detector confidence threshold (0.25 - 0.40).
POULTRYSENSE_DETECTION_CONF=0.25

# Minimum chicken box dimension in pixels (filters out tiny specks, detects background birds)
MIN_CHICKEN_BOX_SIZE=28

# Preview JPEG quality and maximum preview publish rate.
STREAM_JPEG_QUALITY=75
STREAM_MAX_FPS=30
