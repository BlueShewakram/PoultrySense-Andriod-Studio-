{
  "rules": {
    "sensor_data": {
      ".read": true,
      ".write": true
    },
    "system_control": {
      ".read": true,
      ".write": true
    },
    "active_alerts": {
      ".read": true,
      ".write": true
    },
    "diagnostic_verdicts": {
      ".read": true,
      ".write": true
    },
    "alerts": {
      ".read": true,
      ".write": true
    },
    "chicken_baselines": {
      ".read": true,
      ".write": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "farms": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
